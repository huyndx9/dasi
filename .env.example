# Copy thành .env.local và điền giá trị. KHÔNG commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # chỉ dùng ở server (realtime, worker)
SUPABASE_JWT_SECRET=                # realtime gateway xác thực token khi mở WebSocket

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8787
REALTIME_PORT=8787

# --- Queue ---
REDIS_URL=redis://localhost:6379

# --- AI providers ---
STT_PROVIDER=soniox                 # soniox | returnzero | clova | deepgram
SONIOX_API_KEY=
LLM_PROVIDER=anthropic              # anthropic | google
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=                     # model nhanh cho dịch realtime và trợ lý
LLM_MODEL_QUALITY=                  # model cho học liệu sau buổi học
GOOGLE_AI_API_KEY=                  # nếu dùng Gemini

# --- Giới hạn ---
MAX_TARGET_LANGS_PER_LESSON=5
AUDIO_RETENTION_DAYS=90
