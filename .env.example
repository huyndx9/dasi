# Copy thành .env.local và điền giá trị. KHÔNG commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://qcqqadflhiqxjkaizohc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=             # khoá anon hoặc publishable (Project Settings → API Keys)
SUPABASE_SERVICE_ROLE_KEY=          # chỉ dùng ở server (realtime, worker); thiếu thì realtime từ chối mọi kết nối buổi học
SUPABASE_JWT_SECRET=                # realtime gateway xác thực token khi mở WebSocket

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8787
NEXT_PUBLIC_DEMO_LOGIN=0               # 1 = bản thử: nút "Vào thử" không cần tài khoản (đăng nhập ẩn danh). Không bật khi có người dùng thật
REALTIME_PORT=8787
REALTIME_HOST=0.0.0.0
LOG_LEVEL=info                      # fatal | error | warn | info | debug | trace | silent

# --- Queue ---
REDIS_URL=redis://localhost:6379   # hàng đợi lesson.finalize; realtime thiếu biến này vẫn kết thúc buổi học nhưng không đẩy job

# --- AI providers ---
STT_PROVIDER=mock                   # mock | openai · dự kiến: soniox | returnzero | clova | deepgram
STT_MODEL=                          # model OpenAI nhận dạng giọng nói (realtime transcription), khi STT_PROVIDER=openai
SONIOX_API_KEY=
LLM_PROVIDER=mock                   # mock | openai
OPENAI_API_KEY=                     # chỉ dùng ở server (realtime, worker); không commit
LLM_MODEL_FAST=                     # model OpenAI nhanh cho dịch realtime và trợ lý
LLM_MODEL_QUALITY=                  # model OpenAI cho học liệu sau buổi học

# --- Giới hạn ---
MAX_TARGET_LANGS_PER_LESSON=5
AUDIO_RETENTION_DAYS=90
